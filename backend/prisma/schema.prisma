generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Branch {
  id        String   @id @default(uuid()) @db.Uuid
  code      String   @unique @db.VarChar(20)
  name      String   @db.VarChar(120)
  address   String?
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  users     User[]
  auditLogs AuditLog[]
  productPrices ProductPrice[]
  productCosts  ProductCost[]
  warehouses Warehouse[]
  stocks BranchStock[]
  stockMovements StockMovement[]
  sales Sale[]
  receivables Receivable[]
  receivablePayments ReceivablePayment[]
  customerReturns CustomerReturn[]
  outgoingTransfers StockTransfer[] @relation("TransferSourceBranch")
  incomingTransfers StockTransfer[] @relation("TransferDestinationBranch")
  expenses Expense[]
  employees Employee[]
  attendance Attendance[]
  shippingRates ShippingRate[]

  @@map("branches")
}

model Role {
  id          String   @id @default(uuid()) @db.Uuid
  code        String   @unique @db.VarChar(40)
  name        String   @db.VarChar(80)
  description String?
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  users       User[]
  permissions RolePermission[]

  @@map("roles")
}

model Permission {
  id        String   @id @default(uuid()) @db.Uuid
  code      String   @unique @db.VarChar(80)
  module    String   @db.VarChar(40)
  name      String   @db.VarChar(100)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  roles RolePermission[]

  @@index([module])
  @@map("permissions")
}

model RolePermission {
  roleId       String @map("role_id") @db.Uuid
  permissionId String @map("permission_id") @db.Uuid

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model User {
  id           String    @id @default(uuid()) @db.Uuid
  email        String    @unique @db.VarChar(190)
  passwordHash String    @map("password_hash") @db.VarChar(255)
  fullName     String    @map("full_name") @db.VarChar(120)
  roleId       String    @map("role_id") @db.Uuid
  branchId     String?   @map("branch_id") @db.Uuid
  isActive     Boolean   @default(true) @map("is_active")
  lastLoginAt  DateTime? @map("last_login_at") @db.Timestamptz(3)
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  role      Role          @relation(fields: [roleId], references: [id], onDelete: Restrict)
  branch    Branch?       @relation(fields: [branchId], references: [id], onDelete: Restrict)
  sessions  UserSession[]
  auditLogs AuditLog[]    @relation("AuditActor")
  stockMovements StockMovement[]
  sales Sale[] @relation("SaleCashier")
  payments Payment[]
  receivablePayments ReceivablePayment[]
  customerReturns CustomerReturn[]
  transferRequests StockTransfer[] @relation("TransferRequestedBy")
  transferApprovals StockTransfer[] @relation("TransferApprovedBy")
  transferShipments StockTransfer[] @relation("TransferShippedBy")
  transferReceipts StockTransfer[] @relation("TransferReceivedBy")
  expenses Expense[]
  attendanceRecords Attendance[] @relation("AttendanceRecordedBy")
  shippingApprovals Sale[] @relation("ShippingApprovedBy")

  @@index([roleId])
  @@index([branchId, isActive])
  @@map("users")
}

model UserSession {
  id               String    @id @default(uuid()) @db.Uuid
  userId           String    @map("user_id") @db.Uuid
  refreshTokenHash String    @unique @map("refresh_token_hash") @db.Char(64)
  expiresAt        DateTime  @map("expires_at") @db.Timestamptz(3)
  revokedAt        DateTime? @map("revoked_at") @db.Timestamptz(3)
  lastUsedAt       DateTime? @map("last_used_at") @db.Timestamptz(3)
  userAgent        String?   @map("user_agent") @db.VarChar(500)
  ipAddress        String?   @map("ip_address") @db.VarChar(64)
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt, expiresAt])
  @@map("user_sessions")
}

model AuditLog {
  id          String   @id @default(uuid()) @db.Uuid
  actorUserId String?  @map("actor_user_id") @db.Uuid
  branchId    String?  @map("branch_id") @db.Uuid
  action      String   @db.VarChar(80)
  entityType  String   @map("entity_type") @db.VarChar(80)
  entityId    String?  @map("entity_id") @db.VarChar(100)
  oldValue    Json?    @map("old_value")
  newValue    Json?    @map("new_value")
  ipAddress   String?  @map("ip_address") @db.VarChar(64)
  userAgent   String?  @map("user_agent") @db.VarChar(500)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  actor User?   @relation("AuditActor", fields: [actorUserId], references: [id], onDelete: SetNull)
  branch Branch? @relation(fields: [branchId], references: [id], onDelete: SetNull)

  @@index([createdAt(sort: Desc)])
  @@index([actorUserId, createdAt(sort: Desc)])
  @@index([branchId, createdAt(sort: Desc)])
  @@index([entityType, entityId])
  @@map("audit_logs")
}

model ProductCategory {
  id        String   @id @default(uuid()) @db.Uuid
  code      String   @unique @db.VarChar(40)
  name      String   @db.VarChar(120)
  parentId  String?  @map("parent_id") @db.Uuid
  sortOrder Int      @default(0) @map("sort_order")
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  parent   ProductCategory?  @relation("CategoryTree", fields: [parentId], references: [id], onDelete: Restrict)
  children ProductCategory[] @relation("CategoryTree")
  products Product[]

  @@index([parentId, sortOrder])
  @@index([name])
  @@map("product_categories")
}

model Unit {
  id           String   @id @default(uuid()) @db.Uuid
  code         String   @unique @db.VarChar(20)
  name         String   @db.VarChar(60)
  allowDecimal Boolean  @default(false) @map("allow_decimal")
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  baseProducts Product[]     @relation("ProductBaseUnit")
  productUnits ProductUnit[]

  @@map("units")
}

model Product {
  id            String   @id @default(uuid()) @db.Uuid
  sku           String   @unique @db.VarChar(80)
  name          String   @db.VarChar(200)
  brand         String?  @db.VarChar(100)
  productType   String   @default("GENERAL") @map("product_type") @db.VarChar(40)
  description   String?
  imageUrl      String?  @map("image_url") @db.VarChar(500)
  categoryId    String   @map("category_id") @db.Uuid
  baseUnitId    String   @map("base_unit_id") @db.Uuid
  taxPercentage Decimal  @default(0) @map("tax_percentage") @db.Decimal(5, 2)
  isActive      Boolean  @default(true) @map("is_active")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  category  ProductCategory @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  baseUnit  Unit            @relation("ProductBaseUnit", fields: [baseUnitId], references: [id], onDelete: Restrict)
  units     ProductUnit[]
  barcodes  ProductBarcode[]
  prices    ProductPrice[]
  costs     ProductCost[]
  stocks    BranchStock[]
  stockMovements StockMovement[]
  saleItems SaleItem[]
  returnItems CustomerReturnItem[]
  transferItems StockTransferItem[]

  @@index([categoryId, isActive])
  @@index([brand, isActive])
  @@index([updatedAt(sort: Desc)])
  @@map("products")
}

model ProductUnit {
  id               String  @id @default(uuid()) @db.Uuid
  productId        String  @map("product_id") @db.Uuid
  unitId           String  @map("unit_id") @db.Uuid
  conversionToBase Decimal @map("conversion_to_base") @db.Decimal(18, 4)
  isDefaultSale    Boolean @default(false) @map("is_default_sale")

  product  Product          @relation(fields: [productId], references: [id], onDelete: Cascade)
  unit     Unit             @relation(fields: [unitId], references: [id], onDelete: Restrict)
  barcodes ProductBarcode[]
  prices   ProductPrice[]
  saleItems SaleItem[]
  returnItems CustomerReturnItem[]
  transferItems StockTransferItem[]

  @@unique([productId, unitId])
  @@index([productId, isDefaultSale])
  @@map("product_units")
}

model ProductBarcode {
  id            String  @id @default(uuid()) @db.Uuid
  productId     String  @map("product_id") @db.Uuid
  productUnitId String? @map("product_unit_id") @db.Uuid
  barcode       String  @unique @db.VarChar(100)
  label         String? @db.VarChar(100)

  product     Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
  productUnit ProductUnit? @relation(fields: [productUnitId], references: [id], onDelete: SetNull)

  @@index([productId])
  @@map("product_barcodes")
}

model ProductPrice {
  id            String    @id @default(uuid()) @db.Uuid
  branchId      String    @map("branch_id") @db.Uuid
  productId     String    @map("product_id") @db.Uuid
  productUnitId String    @map("product_unit_id") @db.Uuid
  minQuantity   Decimal   @map("min_quantity") @db.Decimal(18, 4)
  sellPrice     Decimal   @map("sell_price") @db.Decimal(18, 2)
  isActive      Boolean   @default(true) @map("is_active")
  validFrom     DateTime? @map("valid_from") @db.Timestamptz(3)
  validTo       DateTime? @map("valid_to") @db.Timestamptz(3)
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  branch      Branch      @relation(fields: [branchId], references: [id], onDelete: Cascade)
  product     Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  productUnit ProductUnit @relation(fields: [productUnitId], references: [id], onDelete: Cascade)

  @@unique([branchId, productUnitId, minQuantity])
  @@index([branchId, productId, isActive])
  @@index([productUnitId, minQuantity(sort: Desc)])
  @@map("product_prices")
}

model ProductCost {
  id        String   @id @default(uuid()) @db.Uuid
  branchId  String   @map("branch_id") @db.Uuid
  productId String   @map("product_id") @db.Uuid
  unitCost  Decimal  @map("unit_cost") @db.Decimal(18, 2)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  branch  Branch  @relation(fields: [branchId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([branchId, productId])
  @@index([productId])
  @@map("product_costs")
}

model Warehouse {
  id        String   @id @default(uuid()) @db.Uuid
  branchId  String   @map("branch_id") @db.Uuid
  code      String   @db.VarChar(30)
  name      String   @db.VarChar(120)
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  branch Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)
  stocks BranchStock[]
  movements StockMovement[]
  outgoingTransfers StockTransfer[] @relation("TransferSourceWarehouse")
  incomingTransfers StockTransfer[] @relation("TransferDestinationWarehouse")

  @@unique([branchId, code])
  @@index([branchId, isActive])
  @@map("warehouses")
}

model BranchStock {
  id               String   @id @default(uuid()) @db.Uuid
  branchId         String   @map("branch_id") @db.Uuid
  warehouseId      String   @map("warehouse_id") @db.Uuid
  productId        String   @map("product_id") @db.Uuid
  quantity         Decimal  @default(0) @db.Decimal(18, 4)
  reservedQuantity Decimal  @default(0) @map("reserved_quantity") @db.Decimal(18, 4)
  damagedQuantity  Decimal  @default(0) @map("damaged_quantity") @db.Decimal(18, 4)
  minimumQuantity  Decimal  @default(0) @map("minimum_quantity") @db.Decimal(18, 4)
  version          Int      @default(1)
  updatedAt        DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  branch Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)
  warehouse Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([warehouseId, productId])
  @@index([branchId, productId])
  @@index([branchId, quantity])
  @@map("branch_stocks")
}

model StockMovement {
  id              String   @id @default(uuid()) @db.Uuid
  branchId        String   @map("branch_id") @db.Uuid
  warehouseId     String   @map("warehouse_id") @db.Uuid
  productId       String   @map("product_id") @db.Uuid
  movementType    String   @map("movement_type") @db.VarChar(40)
  quantity        Decimal  @db.Decimal(18, 4)
  stockBefore     Decimal  @map("stock_before") @db.Decimal(18, 4)
  stockAfter      Decimal  @map("stock_after") @db.Decimal(18, 4)
  referenceType   String?  @map("reference_type") @db.VarChar(40)
  referenceId     String?  @map("reference_id") @db.Uuid
  referenceNumber String?  @map("reference_number") @db.VarChar(80)
  reason          String?
  actorUserId     String?  @map("actor_user_id") @db.Uuid
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  branch Branch @relation(fields: [branchId], references: [id], onDelete: Restrict)
  warehouse Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  product Product @relation(fields: [productId], references: [id], onDelete: Restrict)
  actor User? @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([branchId, createdAt(sort: Desc)])
  @@index([productId, createdAt(sort: Desc)])
  @@index([referenceType, referenceId])
  @@map("stock_movements")
}

model Customer {
  id          String   @id @default(uuid()) @db.Uuid
  name        String   @db.VarChar(150)
  whatsapp    String?  @unique @db.VarChar(30)
  customerType String  @default("RETAIL") @map("customer_type") @db.VarChar(30)
  creditLimit Decimal  @default(0) @map("credit_limit") @db.Decimal(18, 2)
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  sales Sale[]
  receivables Receivable[]
  customerReturns CustomerReturn[]

  @@index([name])
  @@map("customers")
}

model ShippingRate {
  id        String   @id @default(uuid()) @db.Uuid
  branchId  String   @map("branch_id") @db.Uuid
  upToKm    Decimal  @map("up_to_km") @db.Decimal(8, 2)
  fee       Decimal  @db.Decimal(18, 2)
  isActive  Boolean  @default(true) @map("is_active")
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  branch Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@unique([branchId, upToKm])
  @@index([branchId, isActive, upToKm])
  @@map("shipping_rates")
}

model Sale {
  id                     String   @id @default(uuid()) @db.Uuid
  invoiceNumber          String   @unique @map("invoice_number") @db.VarChar(80)
  branchId               String   @map("branch_id") @db.Uuid
  customerId             String?  @map("customer_id") @db.Uuid
  cashierId              String   @map("cashier_id") @db.Uuid
  subtotal               Decimal  @db.Decimal(18, 2)
  discountAmount         Decimal  @default(0) @map("discount_amount") @db.Decimal(18, 2)
  shippingDistanceKm     Decimal  @default(0) @map("shipping_distance_km") @db.Decimal(8, 2)
  shippingFee            Decimal  @default(0) @map("shipping_fee") @db.Decimal(18, 2)
  shippingApprovalStatus String   @default("NOT_REQUIRED") @map("shipping_approval_status") @db.VarChar(30)
  shippingApprovedById   String?  @map("shipping_approved_by_id") @db.Uuid
  grandTotal             Decimal  @map("grand_total") @db.Decimal(18, 2)
  paidAmount             Decimal  @default(0) @map("paid_amount") @db.Decimal(18, 2)
  status                 String   @default("PAID") @db.VarChar(30)
  notes                  String?
  createdAt              DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt              DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  branch Branch @relation(fields: [branchId], references: [id], onDelete: Restrict)
  customer Customer? @relation(fields: [customerId], references: [id], onDelete: Restrict)
  cashier User @relation("SaleCashier", fields: [cashierId], references: [id], onDelete: Restrict)
  shippingApprovedBy User? @relation("ShippingApprovedBy", fields: [shippingApprovedById], references: [id], onDelete: SetNull)
  items SaleItem[]
  payments Payment[]
  receivable Receivable?
  returns CustomerReturn[]

  @@index([branchId, createdAt(sort: Desc)])
  @@index([customerId, createdAt(sort: Desc)])
  @@index([status, createdAt(sort: Desc)])
  @@map("sales")
}

model SaleItem {
  id            String  @id @default(uuid()) @db.Uuid
  saleId        String  @map("sale_id") @db.Uuid
  productId     String  @map("product_id") @db.Uuid
  productUnitId String  @map("product_unit_id") @db.Uuid
  quantity      Decimal @db.Decimal(18, 4)
  baseQuantity  Decimal @map("base_quantity") @db.Decimal(18, 4)
  unitPrice     Decimal @map("unit_price") @db.Decimal(18, 2)
  costPrice     Decimal @default(0) @map("cost_price") @db.Decimal(18, 2)
  lineDiscount  Decimal @default(0) @map("line_discount") @db.Decimal(18, 2)
  lineTotal     Decimal @map("line_total") @db.Decimal(18, 2)

  sale Sale @relation(fields: [saleId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Restrict)
  productUnit ProductUnit @relation(fields: [productUnitId], references: [id], onDelete: Restrict)
  returnItems CustomerReturnItem[]

  @@index([saleId])
  @@index([productId])
  @@map("sale_items")
}

model Payment {
  id          String   @id @default(uuid()) @db.Uuid
  saleId      String   @map("sale_id") @db.Uuid
  method      String   @db.VarChar(30)
  amount      Decimal  @db.Decimal(18, 2)
  reference   String?  @db.VarChar(100)
  actorUserId String   @map("actor_user_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  sale Sale @relation(fields: [saleId], references: [id], onDelete: Cascade)
  actor User @relation(fields: [actorUserId], references: [id], onDelete: Restrict)

  @@index([saleId, createdAt])
  @@map("payments")
}

model Receivable {
  id                String   @id @default(uuid()) @db.Uuid
  saleId            String   @unique @map("sale_id") @db.Uuid
  customerId        String   @map("customer_id") @db.Uuid
  branchId          String   @map("branch_id") @db.Uuid
  originalAmount    Decimal  @map("original_amount") @db.Decimal(18, 2)
  outstandingAmount Decimal  @map("outstanding_amount") @db.Decimal(18, 2)
  dueDate           DateTime? @map("due_date") @db.Date
  status            String   @default("OPEN") @db.VarChar(30)
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  sale Sale @relation(fields: [saleId], references: [id], onDelete: Restrict)
  customer Customer @relation(fields: [customerId], references: [id], onDelete: Restrict)
  branch Branch @relation(fields: [branchId], references: [id], onDelete: Restrict)
  payments ReceivablePayment[]

  @@index([branchId, status, dueDate])
  @@index([customerId, status])
  @@map("receivables")
}

model ReceivablePayment {
  id           String   @id @default(uuid()) @db.Uuid
  receivableId String   @map("receivable_id") @db.Uuid
  branchId     String   @map("branch_id") @db.Uuid
  amount       Decimal  @db.Decimal(18, 2)
  method       String   @db.VarChar(30)
  reference    String?  @db.VarChar(100)
  actorUserId  String   @map("actor_user_id") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  receivable Receivable @relation(fields: [receivableId], references: [id], onDelete: Cascade)
  branch Branch @relation(fields: [branchId], references: [id], onDelete: Restrict)
  actor User @relation(fields: [actorUserId], references: [id], onDelete: Restrict)

  @@index([receivableId, createdAt])
  @@index([branchId, createdAt(sort: Desc)])
  @@map("receivable_payments")
}

model CustomerReturn {
  id           String   @id @default(uuid()) @db.Uuid
  returnNumber String   @unique @map("return_number") @db.VarChar(80)
  saleId       String   @map("sale_id") @db.Uuid
  branchId     String   @map("branch_id") @db.Uuid
  customerId   String?  @map("customer_id") @db.Uuid
  totalRefund  Decimal  @map("total_refund") @db.Decimal(18, 2)
  reason       String
  condition    String   @db.VarChar(30)
  status       String   @default("COMPLETED") @db.VarChar(30)
  actorUserId  String   @map("actor_user_id") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  sale Sale @relation(fields: [saleId], references: [id], onDelete: Restrict)
  branch Branch @relation(fields: [branchId], references: [id], onDelete: Restrict)
  customer Customer? @relation(fields: [customerId], references: [id], onDelete: Restrict)
  actor User @relation(fields: [actorUserId], references: [id], onDelete: Restrict)
  items CustomerReturnItem[]

  @@index([branchId, createdAt(sort: Desc)])
  @@index([saleId])
  @@map("customer_returns")
}

model CustomerReturnItem {
  id            String  @id @default(uuid()) @db.Uuid
  returnId      String  @map("return_id") @db.Uuid
  saleItemId    String  @map("sale_item_id") @db.Uuid
  productId     String  @map("product_id") @db.Uuid
  productUnitId String  @map("product_unit_id") @db.Uuid
  quantity      Decimal @db.Decimal(18, 4)
  baseQuantity  Decimal @map("base_quantity") @db.Decimal(18, 4)
  unitPrice     Decimal @map("unit_price") @db.Decimal(18, 2)
  refundAmount  Decimal @map("refund_amount") @db.Decimal(18, 2)

  customerReturn CustomerReturn @relation(fields: [returnId], references: [id], onDelete: Cascade)
  saleItem SaleItem @relation(fields: [saleItemId], references: [id], onDelete: Restrict)
  product Product @relation(fields: [productId], references: [id], onDelete: Restrict)
  productUnit ProductUnit @relation(fields: [productUnitId], references: [id], onDelete: Restrict)

  @@index([returnId])
  @@index([saleItemId])
  @@map("customer_return_items")
}

model StockTransfer {
  id                     String    @id @default(uuid()) @db.Uuid
  transferNumber         String    @unique @map("transfer_number") @db.VarChar(80)
  sourceBranchId         String    @map("source_branch_id") @db.Uuid
  sourceWarehouseId      String    @map("source_warehouse_id") @db.Uuid
  destinationBranchId    String    @map("destination_branch_id") @db.Uuid
  destinationWarehouseId String    @map("destination_warehouse_id") @db.Uuid
  status                 String    @default("REQUESTED") @db.VarChar(30)
  note                   String?
  requestedById          String    @map("requested_by_id") @db.Uuid
  approvedById           String?   @map("approved_by_id") @db.Uuid
  shippedById            String?   @map("shipped_by_id") @db.Uuid
  receivedById           String?   @map("received_by_id") @db.Uuid
  approvedAt             DateTime? @map("approved_at") @db.Timestamptz(3)
  shippedAt              DateTime? @map("shipped_at") @db.Timestamptz(3)
  receivedAt             DateTime? @map("received_at") @db.Timestamptz(3)
  createdAt              DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt              DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  sourceBranch Branch @relation("TransferSourceBranch", fields: [sourceBranchId], references: [id], onDelete: Restrict)
  destinationBranch Branch @relation("TransferDestinationBranch", fields: [destinationBranchId], references: [id], onDelete: Restrict)
  sourceWarehouse Warehouse @relation("TransferSourceWarehouse", fields: [sourceWarehouseId], references: [id], onDelete: Restrict)
  destinationWarehouse Warehouse @relation("TransferDestinationWarehouse", fields: [destinationWarehouseId], references: [id], onDelete: Restrict)
  requestedBy User @relation("TransferRequestedBy", fields: [requestedById], references: [id], onDelete: Restrict)
  approvedBy User? @relation("TransferApprovedBy", fields: [approvedById], references: [id], onDelete: SetNull)
  shippedBy User? @relation("TransferShippedBy", fields: [shippedById], references: [id], onDelete: SetNull)
  receivedBy User? @relation("TransferReceivedBy", fields: [receivedById], references: [id], onDelete: SetNull)
  items StockTransferItem[]

  @@index([sourceBranchId, status, createdAt(sort: Desc)])
  @@index([destinationBranchId, status, createdAt(sort: Desc)])
  @@map("stock_transfers")
}

model StockTransferItem {
  id            String  @id @default(uuid()) @db.Uuid
  transferId    String  @map("transfer_id") @db.Uuid
  productId     String  @map("product_id") @db.Uuid
  productUnitId String  @map("product_unit_id") @db.Uuid
  quantity      Decimal @db.Decimal(18, 4)
  baseQuantity  Decimal @map("base_quantity") @db.Decimal(18, 4)

  transfer StockTransfer @relation(fields: [transferId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Restrict)
  productUnit ProductUnit @relation(fields: [productUnitId], references: [id], onDelete: Restrict)

  @@unique([transferId, productId])
  @@map("stock_transfer_items")
}

model Expense {
  id            String   @id @default(uuid()) @db.Uuid
  branchId      String   @map("branch_id") @db.Uuid
  category      String   @db.VarChar(80)
  amount        Decimal  @db.Decimal(18, 2)
  paymentMethod String   @map("payment_method") @db.VarChar(30)
  description   String?
  actorUserId   String   @map("actor_user_id") @db.Uuid
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  branch Branch @relation(fields: [branchId], references: [id], onDelete: Restrict)
  actor User @relation(fields: [actorUserId], references: [id], onDelete: Restrict)

  @@index([branchId, createdAt(sort: Desc)])
  @@map("expenses")
}

model Employee {
  id             String   @id @default(uuid()) @db.Uuid
  branchId       String   @map("branch_id") @db.Uuid
  fullName       String   @map("full_name") @db.VarChar(150)
  position       String   @db.VarChar(80)
  phone          String?  @db.VarChar(30)
  scheduledStart String   @default("08:00") @map("scheduled_start") @db.VarChar(5)
  isActive       Boolean  @default(true) @map("is_active")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  branch Branch @relation(fields: [branchId], references: [id], onDelete: Restrict)
  attendance Attendance[]

  @@index([branchId, isActive])
  @@map("employees")
}

model Attendance {
  id             String    @id @default(uuid()) @db.Uuid
  employeeId     String    @map("employee_id") @db.Uuid
  branchId       String    @map("branch_id") @db.Uuid
  attendanceDate DateTime  @map("attendance_date") @db.Date
  scheduledStart String    @map("scheduled_start") @db.VarChar(5)
  checkInAt      DateTime? @map("check_in_at") @db.Timestamptz(3)
  checkOutAt     DateTime? @map("check_out_at") @db.Timestamptz(3)
  status         String    @db.VarChar(30)
  note           String?
  recordedById   String    @map("recorded_by_id") @db.Uuid
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  branch Branch @relation(fields: [branchId], references: [id], onDelete: Restrict)
  recordedBy User @relation("AttendanceRecordedBy", fields: [recordedById], references: [id], onDelete: Restrict)

  @@unique([employeeId, attendanceDate])
  @@index([branchId, attendanceDate])
  @@map("attendance")
}
